# Copy to .env and replace every "change_me" value. Never commit .env.
# Generate secrets with:  openssl rand -hex 32

MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=pollsdb
MYSQL_USER=poll_user
MYSQL_PASSWORD=change_me_db

# Salt for voter hashes
VOTER_SALT=change_me_salt

# Signs login tokens. REQUIRED, at least 32 random characters
JWT_SECRET=change_me_at_least_32_random_characters
JWT_EXPIRES_IN=7d

# Allowed browser origins (comma separated). In production: your public https URL.
CORS_ORIGIN=http://localhost:8080
ENFORCE_ONE_VOTE=true

# ---- Image limits (decoded bytes; the browser compresses before upload) -------
POLL_IMAGE_MAX_BYTES=1572864
AVATAR_MAX_BYTES=262144

# ---- Traffic / proxy ------------------------------------------------------------
RATE_LIMIT_MAX=600
# 1 = only the bundled Nginx proxy. Use 2 if a cloud load balancer / CDN is also in front.
TRUST_PROXY_HOPS=1

# ---- Published host ports (production: HTTP_PORT=80, HTTPS_PORT=443) -----------
HTTP_PORT=8080
HTTPS_PORT=443

# Footer build label (set to your CI run number)
BUILD_NUMBER=local
